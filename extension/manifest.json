{
  "manifest_version": 3,
  "name": "AI Video Radar for YouTube",
  "version": "3.1.0",
  "description": "Offline creator badges for YouTube: AI for AiSList matches, Kagi-listed for Kagi Small Web matches, and ? for unknown creators.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["list.js", "kagi.js", "classify.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "browser_specific_settings": { "gecko": { "id": "ai-video-radar@local", "strict_min_version": "121.0" } }
}
